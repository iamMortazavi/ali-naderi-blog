# Ali Naderi Blog: environment settings.
# Copy this file to .env and fill it in. The values below are the production defaults for
# cPanel shared hosting; for local development see the notes marked "Local:".
# Never commit .env. Never put secrets anywhere else.

APP_NAME="Ali Naderi Blog"
# production on the server. Local: APP_ENV=local
APP_ENV=production
# Leave empty: `php artisan blog:install` (or `php artisan key:generate`) fills it in.
APP_KEY=
# Must be false on the server: true shows stack traces and settings to every visitor.
# Local: APP_DEBUG=true
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
# The public address with https and no trailing slash. Local: http://localhost:8000
APP_URL=https://example.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to storage/logs/laravel-YYYY-MM-DD.log, kept for LOG_DAILY_DAYS days.
# warning keeps them short on shared hosting. Local: LOG_LEVEL=debug
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8 or MariaDB 10.6+ (cPanel → MySQL Databases). cPanel prefixes names with the
# account user, e.g. USER_blog. Local alternative: DB_CONNECTION=sqlite and remove the
# other DB_ lines (the database file is database/database.sqlite).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Tehran offset for the MySQL session, so database NOW() matches APP_TIMEZONE.
DB_TIMEZONE=+03:30

# Files and caches on disk: nothing else is needed on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the panel's login cookie over HTTPS only. Requires the site to run on https://.
# Local over plain http: SESSION_SECURE_COOKIE=false, or you cannot sign in.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker on shared hosting: jobs run immediately; the scheduler (cron) does the rest.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Where uploaded files are stored (covers, audio, note attachments). Default: public/uploads
# inside the release. Set it only when the site is served from public_html instead of
# blog/public (see docs/deploy-cpanel.fa.md):
# UPLOADS_PATH=/home/USER/public_html/uploads

# Mail is not used by the blog; the log mailer keeps Laravel quiet.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- First admin account -------------------------------------------------------------
# Created by `php artisan blog:install` on the first install (database seeder).
# Choose a long password; you can change it in the panel afterwards.
ADMIN_NAME="مدیر سایت"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Telegram (optional) -------------------------------------------------------------
# Bot from @BotFather, added to the channel as an administrator with "Post messages".
TELEGRAM_BOT_TOKEN=
# Channel: @channelname or its numeric id (-100…).
TELEGRAM_CHAT_ID=
# Private chat that receives "published" and "failed" notices for the site owner.
TELEGRAM_NOTIFY_CHAT_ID=

# --- Obsidian vault ------------------------------------------------------------------
# GitHub (Settings → Obsidian in the panel): a fine-grained personal access token limited
# to the vault repository, with Contents: Read-only and nothing else.
VAULT_GITHUB_TOKEN=
# "A folder on this server" mode: the vault folder chosen in the panel must be inside this
# path. Default: the project folder (so `example-vault` works locally).
# VAULT_LOCAL_ROOT=/home/USER/vault
