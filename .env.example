# Copy to .env and fill in. .env is never committed (see .gitignore).
# Used by `make deploy` (tools/blogtools/deploy.py) to publish from this computer.
# The site address comes from site.url in site/data/settings.yaml (admin panel).

# Obsidian vault to publish, relative to this folder or absolute.
VAULT=example-vault

# cPanel → FTP Accounts. Use an account limited to the site folder.
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Folder of the site on the host, relative to the FTP account's home.
FTP_DIR=public_html
# Encrypted FTP (FTPS). Turn off only if the host does not support it: the password then travels in clear text.
FTP_TLS=true

# Optional: Telegram channel posting and maintainer notices (@BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_CHAT_ID=
