# Environment and secrets
.env
.env.backup
.env.production
/auth.json

# Dependencies
/vendor
/node_modules

# Generated by Filament (php artisan filament:upgrade / filament:assets)
/public/css/filament
/public/js/filament
/public/fonts/filament
/public/fonts-manifest.dev.json

# Uploaded files live on the server only; the folder's .htaccess is tracked.
/public/uploads/*
!/public/uploads/.htaccess
/public/storage

# Runtime, caches and build output
/storage/*.key
/storage/pail
/storage/phpstan
/build/
/.phpunit.cache
.phpunit.result.cache
*.log

# Editors, tools and OS files
/.claude/
/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml
.DS_Store
