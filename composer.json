{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ali-naderi/blog",
    "type": "project",
    "description": "Bilingual (Persian/English) blog for cPanel shared hosting: Laravel 13, a Filament 5 admin panel, Obsidian import from GitHub, and Telegram channel posting.",
    "keywords": [
        "laravel",
        "filament",
        "blog",
        "obsidian",
        "telegram",
        "persian",
        "rtl",
        "bilingual",
        "cpanel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4.1",
        "filament/filament": "^5.11",
        "intervention/image": "^4.4",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "symfony/html-sanitizer": "^8.1",
        "symfony/yaml": "^8.1",
        "tempest/highlight": "^2.30"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --seed --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "setup": "Install dependencies, create .env, generate the app key and migrate + seed the database.",
        "test": "Run the PHPUnit test suite.",
        "lint": "Fix code style with Laravel Pint.",
        "lint:check": "Check code style without changing files.",
        "analyse": "Run PHPStan (Larastan) static analysis.",
        "check": "Run every check CI runs: style, static analysis and tests."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
