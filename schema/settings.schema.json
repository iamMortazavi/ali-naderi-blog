{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ali-naderi/blog/schema/settings.schema.json",
  "title": "Site settings",
  "description": "site/data/settings.yaml, edited from the admin panel. tools/blogtools/settings.py checks it before every build so a mistake in the panel stops the deploy instead of breaking the live site.",
  "type": "object",
  "required": ["site", "look", "author"],
  "properties": {
    "site": {
      "type": "object",
      "required": ["url", "title_fa", "title_en"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://[^/\\s]+(/[^\\s]*[^/\\s])?$", "description": "Main address, no trailing slash."},
        "title_fa": {"type": "string", "minLength": 1, "maxLength": 60},
        "title_en": {"type": "string", "minLength": 1, "maxLength": 60}
      }
    },
    "look": {"type": "string", "enum": ["paper", "ink"]},
    "author": {
      "type": "object",
      "required": ["name_fa", "name_en"],
      "properties": {
        "name_fa": {"type": "string", "minLength": 1},
        "name_en": {"type": "string", "minLength": 1},
        "bio_fa": {"type": "string", "maxLength": 300},
        "bio_en": {"type": "string", "maxLength": 300}
      }
    },
    "menu": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["label_fa", "label_en", "path"],
        "properties": {
          "label_fa": {"type": "string", "minLength": 1, "maxLength": 30},
          "label_en": {"type": "string", "minLength": 1, "maxLength": 30},
          "path": {"type": "string", "pattern": "^(/[a-z0-9/_-]*|https?://\\S+)$"}
        }
      }
    },
    "social": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "enum": ["telegram", "github", "x", "linkedin", "instagram", "youtube", "email"]},
          "url": {"type": "string", "pattern": "^(https?://|mailto:)\\S+$"}
        }
      }
    },
    "telegram": {
      "type": "object",
      "properties": {
        "channel": {"type": "string", "pattern": "^(https://t\\.me/\\S+)?$"},
        "languages": {"type": "array", "items": {"type": "string", "enum": ["fa", "en"]}},
        "hashtags": {"type": "boolean"},
        "footer_fa": {"type": "string", "maxLength": 200},
        "footer_en": {"type": "string", "maxLength": 200}
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "google_verification": {"type": "string", "pattern": "^[A-Za-z0-9_-]*$"},
        "bing_verification": {"type": "string", "pattern": "^[A-Za-z0-9_-]*$"}
      }
    }
  }
}
