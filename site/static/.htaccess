# Apache settings for the cPanel host. Uploaded with the site on every deploy.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Use the address without www. (Swap the two conditions to prefer www.)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The deploy tool's record of uploaded files must not be public.
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

  # Permanent redirects for renamed addresses go here, one per line, for example:
  # RewriteRule ^posts/old-slug/?$ /posts/new-slug/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # File names that contain a content hash never change: cache them for a year.
  <FilesMatch "\.[0-9a-f]{20,}\.(js|css)$|_hu_[0-9a-f]+\.(webp|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|svg|png|jpg|jpeg|webp|gif|mp3|m4a|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages change on every publish: let browsers check for a newer copy.
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <Files "build.json">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/json application/javascript application/ld+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .js .json .xml .txt
</IfModule>
