{{- /* Search index for /search/. Small on purpose: titles, descriptions, tags and the start of each post. */ -}}
{{- $items := slice -}}
{{- range (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
  {{- $items = $items | append (dict
    "t" .Title
    "u" .RelPermalink
    "d" (partial "description.html" .)
    "g" (.Params.tags | default slice)
    "a" (partial "date.html" .Date)
    "c" (.Plain | truncate 3000 "")
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
